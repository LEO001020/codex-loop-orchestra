      f\"Codex Desktop native child ceiling reached ({active}/{cap}). \"\n            \"Keep the logical 16/48-agent LOOP target by dispatching the \"\n            \"remaining packet through headless codex exec; 8765 aggregates \"\n            \"both planes. Do not refill another Desktop-native slot yet.\"\n        ),\n    }}\n\n\ndef evaluate(payload: dict[str, Any], status: dict[str, Any], cap: int) -> dict[str, Any]:\n    if not is_native_spawn(payload):\n        return {}\n    active = desktop_active(status)\n    return denial(active, cap) if active >= cap else {}\n\n\ndef main() -> int:\n    try:\n        payload = json.loads(sys.stdin.read() or \"{}\")\n        if not isinstance(payload, dict) or not is_native_spawn(payload):\n            print(\"{}\")\n            return 0\n        if os.environ.get(\"LOOP_DESKTOP_NATIVE_GUARD\", \"on\").lower() in {\n            \"0\", \"false\", \"off\"\n        }:\n            print(\"{}\")\n            return 0\n        cap = max(1, int(os.environ.get(\"LOOP_DESKTOP_NATIVE_CAP\", DEFAULT_CAP)))\n        print(json.dumps(evaluate(payload, read_status(), cap)))\n    except Exception as exc:\n        # Observation failure must not paralyse Codex.  Keep the diagnostic\n        # generic so no prompt/tool arguments are copied into logs.\n        print(\"{}\")\n        print(f\"desktop_spawn_guard degraded: {type(exc).__name__}\", file=sys.stderr)\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\r\n","exit_code":0,"status":"completed"}}
