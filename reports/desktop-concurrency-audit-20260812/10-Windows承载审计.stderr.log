.\reports\desktop-concurrency-audit-20260812\01-ç¡¬é—¨è¯­ä¹‰å®¡è®¡.jsonl:7:{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content -Raw hooks/desktop_spawn_guard.py'","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Keep wide LOOP waves off the Codex Desktop Electron process.\n\nThe guard is intentionally narrow: it only examines native spawn tool calls,\nuses the local 8765 observer as its read-only source, and fails open whenever\nthat source is unavailable.  Headless ``codex exec`` births never pass through\nthis tool hook and are therefore unaffected.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport sys\nimport urllib.request\nfrom typing import Any\n\n\nDEFAULT_CAP = 8\nSTATUS_URL = \"http://127.0.0.1:8765/api/status\"\n\n\ndef is_native_spawn(payload: dict[str, Any]) -> bool:\n    tool = str(payload.get(\"tool_name\") or payload.get(\"tool\") or \"\").lower()\n    return \"spawn_agent\" in tool\n\n\ndef desktop_active(status: dict[str, Any]) -> int:\n    tasks = status.get(\"tasks\")\n    if not isinstance(tasks, list):\n        return 0\n    return sum(\n        1 for task in tasks\n        if isinstance(task, dict)\n        and str(task.get(\"plane\") or \"\").lower().startswith(\"desktop rollout\")\n        and str(task.get(\"state\") or \"\").lower() not in {\n            \"completed\", \"failed\", \"cancelled\", \"timed_out\", \"terminal\"\n        }\n    )\n\n\ndef read_status(url: str = STATUS_URL) -> dict[str, Any]:\n    with urllib.request.urlopen(url, timeout=0.75) as response:\n        value = json.load(response)\n    return value if isinstance(value, dict) else {}\n\n\ndef denial(active: int, cap: int) -> dict[str, Any]:\n    return {\"hookSpecificOutput\": {\n        \"hookEventName\": \"PreToolUse\",\n        \"permissionDecision\": \"deny\",\n        \"permissionDecisionReason\": (\n            f\"Codex Desktop native child ceiling reached ({active}/{cap}). \"\n            \"Keep the logical 16/48-agent LOOP target by dispatching the \"\n            \"remaining packet through headless codex exec; 8765 aggregates \"\n            \"both planes. Do not refill another Desktop-native slot yet.\"\n        ),\n    }}\n\n\ndef evaluate(payload: dict[str, Any], status: dict[str, Any], cap: int) -> dict[str, Any]:\n    if not is_native_spawn(payload):\n        return {}\n    active = desktop_active(status)\n    return denial(active, cap) if active >= cap else {}\n\n\ndef main() -> int:\n    try:\n        payload = json.loads(sys.stdin.read() or \"{}\")\n        if not isinstance(payload, dict) or not is_native_spawn(payload):\n            print(\"{}\")\n            return 0\n        if os.environ.get(\"LOOP_DESKTOP_NATIVE_GUARD\", \"on\").lower() in {\n            \"0\", \"false\", \"off\"\n        }:\n            print(\"{}\")\n            return 0\n        cap = max(1, int(os.environ.get(\"LOOP_DESKTOP_NATIVE_CAP\", DEFAULT_CAP)))\n        print(json.dumps(evaluate(payload, read_status(), cap)))\n    except Exception as exc:\n        # Observation failure must not paralyse Codex.  Keep the diagnostic\n        # generic so no prompt/tool arguments are copied into logs.\n        print(\"{}\")\n        print(f\"desktop_spawn_guard degraded: {type(exc).__name__}\", file=sys.stderr)\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\r\n","exit_code":0,"status":"completed"}}
