 TERMINAL = {"MERGED", "DEAD_LETTER", "SOL_ADJUDICATE", "DONE"}
+SUPERVISOR_HEARTBEAT_STALE_SECONDS = 5.0
+# Packet-id -> filename safety: 1-96 ASCII letters/digits/._- ONLY.  Any
