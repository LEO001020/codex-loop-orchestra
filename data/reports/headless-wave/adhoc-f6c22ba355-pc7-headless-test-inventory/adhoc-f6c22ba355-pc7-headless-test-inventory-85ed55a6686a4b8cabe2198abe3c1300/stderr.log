import hashlib
import json
import tempfile
import threading
import unittest
from concurrent.futures import ThreadPoolExecutor
from contextlib import closing
from datetime import datetime, timedelta, timezone
from pathlib import Path

from p5_infra.queue_db import FailClosed, QueueDB


H64 = "a" * 64
GIT = "3aa1351c8b8cf7f06157782f8194d27ad6274666"


def job(job_id: str = "job-1", trial: str = "trial-1", job_type: str = "torch_model_train") -> dict:
    return {
        "job_id": job_id,
        "logical_trial_id": trial,
        "experiment_id": "experiment-1",
        "job_type": job_type,
        "git_sha": GIT,
        "dataset_manifest_sha": H64,
        "config_sha": "b" * 64,
        "environment_sha": "c" * 64,
        "gpu_required": True,
        "checkpointable": True,
        "max_wall_seconds": 600,
        "trial_accounting_policy": "one-logical-trial-infrastructure-retries-do-not-count",
        "command": ["python", "train.py", "--config", "frozen.json"],
        "expected_outputs": ["result.json"],
    }


def capabilities() -> dict:
    return {
        "gpu_available": True,
        "supported_job_types": ["torch_model_train", "alphasage_smoke"],
    }


class QueueDBTests(unittest.TestCase):
    def setUp(self) -> None:
        self.temp = tempfile.TemporaryDirectory()
        self.root = Path(self.temp.name) / "queue"
        self.db = QueueDB(self.root)
        self.db.initialize()

    def tearDown(self) -> None:
        self.temp.cleanup()

    def result(self, lease: dict) -> dict:
        artifact = self.root / "incoming" / lease["attempt_id"] / "result.json"
        artifact.parent.mkdir(parents=True, exist_ok=True)
        artifact.write_bytes(b"verified result\n")
        return {
            "job_id": lease["job_id"],
            "attempt_id": lease["attempt_id"],
            "git_sha": lease["git_sha"],
            "dataset_manifest_sha": lease["dataset_manifest_sha"],
            "config_sha": lease["config_sha"],
            "environment_sha": lease["environment_sha"],
            "outputs": [{
                "path": "result.json",
                "sha256": hashlib.sha256(artifact.read_bytes()).hexdigest(),
            }],

