E:\VPS\p5-boot-image-preflight-20260810T144519Z\instance.json:        "value": "#!/usr/bin/env bash\n# ============================================================================\n# K3-P4 startup bootstrap (v4, micro-patched) -- IDEMPOTENT, STRICT-FAIL\n# ----------------------------------------------------------------------------\n# Purpose : Runs on every boot of the (Spot, recreatable) k3-p4 VM.\n# Changes vs v3 (micro-patches):\n#   PATCH A: NO recursive chown. Targeted, non-recursive ownership of\n#            /data/k3 itself, bootstrap-created top-level dirs, and\n#            bootstrap-created state files ONLY. Existing ownership below\n#            repo/artifact/data trees is preserved (large Parquet/L2 lake).\n#   PATCH B: Bounded retry helper retry() with exponential backoff (3\n#            attempts) for all network-dependent operations: apt-get update,\n#            apt-get install, astral.sh uv install, NodeSource setup_22.x,\n#            get.docker.com download + install. Retries exhausted => die()\n#            (strict FAIL, never WARN/OK). Each attempt is logged.\n# Changes vs v2 (audit fixes, retained):\n#   ISSUE 1: set -Eeuo pipefail + ERR trap -> STATUS=OK impossible on any\n#            unguarded command failure. die() kept for explicit failures.\n#   ISSUE 2: Full G1 runtime is idempotently installed & VERIFIED on every\n#            boot (apt base tools, python3, uv, Node 22 + npm, Docker Engine).\n#            Missing required tool after install attempt => FAIL, not WARN.\n#   ISSUE 3: SSH hardening drop-in /etc/ssh/sshd_config.d/99-k3-hardening.conf\n#            is recreated every boot; sshd -t gated; single ssh restart after\n#            host-key restore + hardening; effective config verified (sshd -T).\n#   ISSUE 4: user k3 is waited for (<=60s), created if still absent, added to\n#            docker group; chown of /data/k3 itself failing is FATAL.\n#   ISSUE 5: All v2 safety invariants preserved:\n#            - NEVER auto-format the data disk\n#            - NEVER touch the boot disk\n#            - /data mounted by UUID; existing filesystem UUID unchanged\n#            - NO SECRETS in this script or instance metadata\n# Guarantees:\n#   1. Waits for the 300GB stateful data disk (device: persistent-disk-1).\n#   2. NEVER formats a disk that already has a filesystem. NEVER touches the\n#      boot disk. If the data disk has no filesystem, it FAILS EXPLICITLY\n#      (manual mkfs decision only -- see Section 9 of the execution guide).\n#   3. Mounts /data via UUID, repairs /etc/fstab idempotently.\n#   4. Recreates the /data/k3 directory tree (mkdir -p, never destructive).\n#   5. Plan A: restores persisted SSH host keys from /data/k3/system/ssh-host-keys\n#      so the host l survives MIG recreation.\n#   6. Recreates SSH hardening drop-in and verifies effective sshd config.\n#   7. Installs/verifies ALL required G1 runtime (fails if any required tool\n#      is missing after install attempt).\n#   8. Writes a machine-readable status file and a full log.\n#      Log:    /var/log/k3-bootstrap.log\n#      Status: /data/k3/system/last_bootstrap.json  (+ /var/run/k3-bootstrap.ok)\n# ============================================================================\nset -Eeuo pipefail\n\nLOG=/var/log/k3-bootstrap.log\nexec > >(tee -a \"$LOG\") 2>&1\n\nexport DEBIAN_FRONTEND=noninteractive\n\nTS() { date -u +%Y-%m-%dT%H:%M:%SZ; }\nSTATUS=\"unknown\"\nFAIL_REASON=\"\"\n\nlog() { echo \"[$(TS)] $*\"; }\n\nwrite_status() {\n  local mounted=\"false\"\n  if mountpoint -q /data 2>/dev/null; then mounted=\"true\"; fi\n  if [ \"$mounted\" = \"true\" ]; then\n    mkdir -p /data/k3/system || true\n    cat > /data/k3/system/last_bootstrap.json <<EOF || true\n{\"ts\":\"$(TS)\",\"hostname\":\"$(hostname)\",\"status\":\"${STATUS}\",\"reason\":\"${FAIL_REASON}\",\"data_mounted\":${mounted},\"boot_id\":\"$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)\"}\nEOF\n  fi\n  if [ \"$STATUS\" = \"OK\" ]; then\n    touch /var/run/k3-bootstrap.ok || true\n  else\n    rm -f /var/run/k3-bootstrap.ok || true\n  fi\n}\n\ndie() {\n  trap - ERR\n  STATUS=\"FAIL\"\n  FAIL_REASON=\"$*\"\n  log \"FATAL: $*\"\n  write_status\n  exit 1\n}\n\n# ISSUE 1: ERR trap -- any unguarded command failure aborts with FAIL status.\non_err() {\n  local rc=$1 line=$2 cmd=$3\n  trap - ERR\n  STATUS=\"FAIL\"\n  FAIL_REASON=\"ERR trap: command '${cmd}' failed (rc=${rc}) at line ${line}\"\n  log \"FATAL: ${FAIL_REASON}\"\n  write_status\n  exit 1\n}\ntrap 'on_err $? $LINENO \"$BASH_COMMAND\"' ERR\n\n# ---------------------------------------------------------------------------\n# PATCH B: bounded retry helper with exponential backoff for network-dependent\n# operations. Finite attempts; retries exhausted => die() (strict FAIL).\n# The ERR trap is temporarily disabled during each attempt so a transient\n# failure reaches the retry logic instead of aborting via on_err; the trap is\n# restored before returning / before die().\n# ---------------------------------------------------------------------------\nretry() {\n  local max_attempts=$1 delay=$2; shift 2\n  local attempt=1 rc=0\n  while [ \"$attempt\" -le \"$max_attempts\" ]; do\n    log \"retry ${attempt}/${max_attempts}: attempting: $*\"\n    trap - ERR\n    set +e\n    \"$@\"\n    rc=$?\n    set -e\n    trap 'on_err $? $LINENO \"$BASH_COMMAND\"' ERR\n    if [ \"$rc\" -eq 0 ]; then\n      log \"retry ${attempt}/${max_attempts} succeeded: $*\"\n      return 0\n    fi\n    if [ \"$attempt\" -lt \"$max_attempts\" ]; then\n      log \"retry ${attempt}/${max_attempts} for '$*' after failure (rc=${rc}); sleeping ${delay}s before next attempt\"\n      sleep \"$delay\"\n    else\n      log \"retry ${attempt}/${max_attempts} for '$*' failed (rc=${rc}); retries exhausted\"\n    fi\n    attempt=$((attempt+1))\n    delay=$((delay * 2))  # exponential backoff\n  done\n  die \"retries exhausted (${max_attempts} attempts) for: $*\"\n}\n\nlog \"===== k3-p4 bootstrap start (template v4) =====\"\n\n# ---------------------------------------------------------------------------\n# STEP 1: Wait for the stateful data disk (up to 180 s)\n# ---------------------------------------------------------------------------\nDISK=\"/dev/disk/by-id/google-persistent-disk-1\"\nWAITED=0\nuntil [ -e \"$DISK\" ]; do\n  [ \"$WAITED\" -ge 180 ] && die \"data disk $DISK not present after 180s\"\n  sleep 5; WAITED=$((WAITED+5))\n  log \"waiting for $DISK (${WAITED}s)\"\ndone\nREAL_DEV=\"$(readlink -f \"$DISK\")\"\nlog \"data disk present: $DISK -> $REAL_DEV\"\n\n# ---------------------------------------------------------------------------\n# STEP 2: Safety -- confirm this is NOT the boot disk and is ~300GB (ISSUE 5)\n# ---------------------------------------------------------------------------\nBOOT_DEV=\"$(findmnt -no SOURCE / | sed -E 's/p?[0-9]+$//')\"\ncase \"$REAL_DEV\" in\n  \"$BOOT_DEV\"*) die \"safety abort: $DISK resolves to boot device $BOOT_DEV\" ;;\nesac\nSIZE_GB=$(( $(blockdev --getsize64 \"$REAL_DEV\") / 1024 / 1024 / 1024 ))\nif [ \"$SIZE_GB\" -lt 290 ] || [ \"$SIZE_GB\" -gt 310 ]; then\n  die \"safety abort: $DISK size ${SIZE_GB}GB is not ~300GB\"\nfi\nlog \"safety checks passed: non-boot, ${SIZE_GB}GB\"\n\n# ---------------------------------------------------------------------------\n# STEP 3: Filesystem check -- NEVER reformat. Fail explicitly if blank. (ISSUE 5)\n# ---------------------------------------------------------------------------\nFSTYPE=\"$(blkid -s TYPE -o value \"$REAL_DEV\" 2>/dev/null || true)\"\nif [ -z \"$FSTYPE\" ]; then\n  die \"data disk has NO filesystem. Refusing to auto-format. Run Section 9 (manual, gated mkfs) once.\"\nfi\nif [ \"$FSTYPE\" != \"ext4\" ]; then\n  die \"data disk has unexpected filesystem '$FSTYPE' (expected ext4). Manual inspection required.\"\nfi\nUUID=\"$(blkid -s UUID -o value \"$REAL_DEV\")\"\nlog \"filesystem ok: ext4 UUID=$UUID\"\n\n# ---------------------------------------------------------------------------\n# STEP 4: Idempotent fstab repair + mount /data (by UUID)\n# ---------------------------------------------------------------------------\nmkdir -p /data\nFSTAB_LINE=\"UUID=$UUID /data ext4 defaults,nofail 0 2\"\nHAS_DATA_LINE=0; HAS_UUID_LINE=0\nif grep -qE '^[^#]*\\s/data\\s' /etc/fstab; then HAS_DATA_LINE=1; fi\nif grep -qF \"UUID=$UUID /data\" /etc/fstab; then HAS_UUID_LINE=1; fi\nif [ \"$HAS_DATA_LINE\" -eq 1 ] && [ \"$HAS_UUID_LINE\" -eq 0 ]; then\n  cp -a /etc/fstab \"/etc/fstab.bak.$(date -u +%s)\"\n  sed -i -E '\\#^[^\\#]*\\s/data\\s#d' /etc/fstab\n  log \"removed stale /data fstab entries (backup kept)\"\n  HAS_UUID_LINE=0\nfi\nif ! grep -qF \"UUID=$UUID /data\" /etc/fstab; then\n  echo \"$FSTAB_LINE\" >> /etc/fstab\n  log \"fstab entry added\"\nfi\nsystemctl daemon-reload\nif ! mountpoint -q /data; then\n  mount /data || die \"mount /data failed\"\nfi\nlog \"/data mounted: $(findmnt -no SOURCE,FSTYPE,OPTIONS /data)\"\n\n# ---------------------------------------------------------------------------\n# STEP 5a: Recreate K3 directory tree (never destructive)\n# ---------------------------------------------------------------------------\nmkdir -p /data/k3/{repo,state,external-repos,runs,experiments,checkpoints,artifacts,backups,infra,system}\nmkdir -p /data/k3/data/{raw,normalized,parquet,microstructure}\nfor f in p4_progress.jsonl cost_ledger.jsonl preemptions.jsonl; do\n  [ -f \"/data/k3/state/$f\" ] || touch \"/data/k3/state/$f\"\ndone\nlog \"directory tree ensured\"\n\n# ---------------------------------------------------------------------------\n# STEP 5b: ISSUE 4 -- ensure user k3 exists (wait <=60s, then create), then\n# apply TARGETED, NON-RECURSIVE ownership (PATCH A).\n# ---------------------------------------------------------------------------\nK3_WAIT=0\nwhile ! id k3 >/dev/null 2>&1; do\n  if [ \"$K3_WAIT\" -ge 60 ]; then\n    log \"user k3 absent after ${K3_WAIT}s; creating via useradd\"\n    useradd -m -s /bin/bash k3 || die \"useradd k3 failed\"\n    break\n  fi\n  log \"waiting for user k3 (${K3_WAIT}s elapsed; guest agent may create it)\"\n  sleep 5; K3_WAIT=$((K3_WAIT+5))\ndone\nid k3 >/dev/null 2>&1 || die \"user k3 still does not exist after wait/create\"\n\n# PATCH A: targeted, NON-RECURSIVE ownership. No chown -R anywhere.\n# 1) /data/k3 itself: failure here is fatal (but never recursive).\nchown k3:k3 /data/k3 || die \"chown k3:k3 /data/k3 failed\"\n# 2) Bootstrap-created top-level directories only (Step 5a mkdir -p set).\n#    Non-recursive: existing ownership below repo/artifact/data trees is\n#    preserved (large Parquet/L2 data lake must NOT be traversed).\nK3_OWNED_DIRS=(\n  /data/k3/repo /data/k3/state /data/k3/external-repos /data/k3/runs\n  /data/k3/experiments /data/k3/checkpoints /data/k3/artifacts\n  /data/k3/backups /data/k3/infra /data/k3/system\n  /data/k3/data /data/k3/data/raw /data/k3/data/normalized\n  /data/k3/data/parquet /data/k3/data/microstructure\n)\nfor d in \"${K3_OWNED_DIRS[@]}\"; do\n  [ -d \"$d\" ] && chown k3:k3 \"$d\" || true\ndone\n# 3) Bootstrap-created state files (only if they exist).\nfor f in /data/k3/state/p4_progress.jsonl /data/k3/state/cost_ledger.jsonl /data/k3/state/preemptions.jsonl; do\n  [ -f \"$f\" ] && chown k3:k3 \"$f\" || true\ndone\nlog \"user k3 present; targeted non-recursive ownership applied to /data/k3 tree tops\"\n\n# ---------------------------------------------------------------------------\n# STEP 6: Plan A -- restore persisted SSH host keys (restart deferred to 6b)\n# ---------------------------------------------------------------------------\nHK_DIR=/data/k3/system/ssh-host-keys\nSSH_NEEDS_RESTART=0\nHK_FOUND=0\nif [ -d \"$HK_DIR\" ]; then\n  if ls \"$HK_DIR\"/ssh_host_*_key >/dev/null 2>&1; then HK_FOUND=1; fi\nfi\nif [ \"$HK_FOUND\" -eq 1 ]; then\n  for k in \"$HK_DIR\"/ssh_host_*; do\n    b=\"$(basename \"$k\")\"\n    if ! cmp -s \"$k\" \"/etc/ssh/$b\"; then\n      install -m 600 -o root -g root \"$k\" \"/etc/ssh/$b\"\n      case \"$b\" in *.pub) chmod 644 \"/etc/ssh/$b\";; esac\n      SSH_NEEDS_RESTART=1\n    fi\n  done\n  if [ \"$SSH_NEEDS_RESTART\" -eq 1 ]; then\n    log \"SSH host keys restored from $HK_DIR (ssh restart deferred to hardening step)\"\n  else\n    log \"SSH host keys already match persisted copies\"\n  fi\nelse\n  log \"NOTE: no persisted host keys at $HK_DIR (Plan A seed step not done yet, or Plan B in use)\"\nfi\n\n# ---------------------------------------------------------------------------\n# STEP 6b: ISSUE 3 -- recreate SSH hardening drop-in, validate, restart, verify\n# ---------------------------------------------------------------------------\nHARDEN=/etc/ssh/sshd_config.d/99-k3-hardening.conf\nHARDEN_CONTENT='PermitRootLogin no\nPasswordAuthentication no\nKbdInteractiveAuthentication no\nPubkeyAuthentication yes'\nmkdir -p /etc/ssh/sshd_config.d\nif [ ! -f \"$HARDEN\" ] || [ \"$(cat \"$HARDEN\")\" != \"$HARDEN_CONTENT\" ]; then\n  printf '%s\\n' \"$HARDEN_CONTENT\" > \"$HARDEN\"\n  chmod 644 \"$HARDEN\"\n  SSH_NEEDS_RESTART=1\n  log \"SSH hardening drop-in (re)written: $HARDEN\"\nelse\n  log \"SSH hardening drop-in already correct: $HARDEN\"\nfi\nsshd -t || die \"sshd -t failed: sshd config invalid; refusing to restart ssh\"\nif [ \"$SSH_NEEDS_RESTART\" -eq 1 ]; then\n  systemctl restart ssh || die \"ssh restart failed after host-key restore / hardening\"\n  log \"ssh restarted (host keys + hardening applied in one restart)\"\nelse\n  systemctl reload ssh || systemctl restart ssh || die \"ssh reload/restart failed\"\n  log \"ssh reloaded (no changes needed, config re-asserted)\"\nfi\n# Verify EFFECTIVE config\nSSHD_EFF=\"$(sshd -T 2>/dev/null | grep -Ei '^(permitrootlogin|passwordauthentication|kbdinteractiveauthentication|pubkeyauthentication) ' || true)\"\nfor want in \"permitrootlogin no\" \"passwordauthentication no\" \"kbdinteractiveauthentication no\" \"pubkeyauthentication yes\"; do\n  if ! printf '%s\\n' \"$SSHD_EFF\" | grep -qix \"$want\"; then\n    die \"sshd effective config check failed: wanted '$want'; got: $(echo \"$SSHD_EFF\" | tr '\\n' '; ')\"\n  fi\ndone\nlog \"sshd effective config verified: rootlogin=no, passwordauth=no, kbdinteractive=no, pubkey=yes\"\n\n# ---------------------------------------------------------------------------\n# STEP 7: ISSUE 2 -- idempotently install + VERIFY all required G1 runtime\n# (network-dependent operations wrapped in retry -- PATCH B)\n# ---------------------------------------------------------------------------\nAPT_PKGS=(git curl wget ca-certificates jq rsync make gcc g++ build-essential pkg-config sqlite3 tmux zstd unzip)\n\nAPT_UPDATED=0\napt_update_once() {\n  if [ \"$APT_UPDATED\" -eq 0 ]; then\n    retry 3 5 apt-get update -y\n    APT_UPDATED=1\n  fi\n}\n\n# PATCH B helper wrappers for curl|sh pipelines (so retry can re-run them)\nuv_install_k3() {\n  su - k3 -c 'curl -LsSf https://astral.sh/uv/install.sh | sh'\n}\nnodesource_setup_22() {\n  curl -fsSL https://deb.nodesource.com/setup_22.x | bash -\n}\ndocker_script_download() {\n  curl -fsSL https://get.docker.com -o /tmp/get-docker.sh\n}\n\n# 7.1 base apt packages -- install only what's missing\nMISSING_PKGS=()\nfor p in \"${APT_PKGS[@]}\"; do\n  if ! dpkg -s \"$p\" >/dev/null 2>&1; then MISSING_PKGS+=(\"$p\"); fi\ndone\nif [ \"${#MISSING_PKGS[@]}\" -gt 0 ]; then\n  log \"installing missing apt packages: ${MISSING_PKGS[*]}\"\n  apt_update_once\n  retry 3 5 apt-get install -y \"${MISSING_PKGS[@]}\"\nelse\n  log \"all base apt packages already installed\"\nfi\n\n# 7.2 python3 (expected on Ubuntu 24.04 base image)\nif ! command -v python3 >/dev/null 2>&1; then\n  log \"python3 missing; installing\"\n  apt_update_once\n  retry 3 5 apt-get install -y python3 python3-venv\nfi\n\n# 7.3 uv (astral.sh installer, into k3's ~/.local/bin)\nUV_BIN=\"\"\nif command -v uv >/dev/null 2>&1; then\n  UV_BIN=\"$(command -v uv)\"\nelif [ -x /home/k3/.local/bin/uv ]; then\n  UV_BIN=/home/k3/.local/bin/uv\nfi\nif [ -z \"$UV_BIN\" ]; then\n  log \"uv missing; installing via astral.sh for user k3\"\n  retry 3 5 uv_install_k3\n  [ -x /home/k3/.local/bin/uv ] || die \"uv still missing at /home/k3/.local/bin/uv after install\"\n  UV_BIN=/home/k3/.local/bin/uv\nfi\n\n# 7.4 Node.js 22 + npm (NodeSource)\nNODE_OK=0\nif command -v node >/dev/null 2>&1; then\n  NODE_V=\"$(node --version 2>/dev/null || true)\"\n  case \"$NODE_V\" in v22.*) NODE_OK=1 ;; esac\nfi\nif [ \"$NODE_OK\" -eq 0 ]; then\n  log \"Node 22 missing (found: ${NODE_V:-none}); installing via NodeSource setup_22.x\"\n  retry 3 5 nodesource_setup_22\n  retry 3 5 apt-get install -y nodejs\n  case \"$(node --version 2>/dev/null || true)\" in v22.*) : ;; *) die \"node is not v22.x after install\" ;; esac\nfi\ncommand -v npm >/dev/null 2>&1 || die \"npm missing (should ship with nodejs)\"\n\n# 7.5 Docker Engine (get.docker.com) + k3 in docker group\nif ! command -v docker >/dev/null 2>&1; then\n  log \"docker missing; installing via get.docker.com\"\n  retry 3 5 docker_script_download\n  retry 3 5 sh /tmp/get-docker.sh\n  rm -f /tmp/get-docker.sh\nfi\ngetent group docker >/dev/null 2>&1 || groupadd docker || die \"groupadd docker failed\"\nif ! id -nG k3 | tr ' ' '\\n' | grep -qx docker; then\n  usermod -aG docker k3 || die \"usermod -aG docker k3 failed\"\n  log \"added k3 to docker group\"\nfi\nif ! systemctl is-active --quiet docker; then\n  systemctl start docker || die \"docker installed but failed to start\"\nfi\n\n# 7.6 VERIFY every required tool; any miss => FAIL\ndeclare -A TOOLCHECK=(\n  [git]=\"git --version\"\n  [curl]=\"curl --version | head -1\"\n  [wget]=\"wget --version | head -1\"\n  [jq]=\"jq --version\"\n  [rsync]=\"rsync --version | head -1\"\n  [make]=\"make --version | head -1\"\n  [gcc]=\"gcc --version | head -1\"\n  [g++]=\"g++ --version | head -1\"\n  [pkg-config]=\"pkg-config --version\"\n  [sqlite3]=\"sqlite3 --version\"\n  [tmux]=\"tmux -V\"\n  [zstd]=\"zstd --version\"\n  [unzip]=\"unzip -v | head -1\"\n  [python3]=\"python3 --version\"\n  [node]=\"node --version\"\n  [npm]=\"npm --version\"\n  [docker]=\"docker --version\"\n)\nRUNTIME_MISSING=\"\"\nfor t in \"${!TOOLCHECK[@]}\"; do\n  if command -v \"$t\" >/dev/null 2>&1; then\n    V=\"$(bash -c \"${TOOLCHECK[$t]}\" 2>/dev/null || echo '?')\"\n    log \"runtime ok: $t -> $V\"\n  else\n    RUNTIME_MISSING=\"$RUNTIME_MISSING $t\"\n  fi\ndone\n# uv checked separately (may live only in k3's ~/.local/bin)\nif [ -n \"$UV_BIN\" ] && [ -x \"$UV_BIN\" ]; then\n  log \"runtime ok: uv -> $(\"$UV_BIN\" --version 2>/dev/null || echo '?') ($UV_BIN)\"\nelse\n  RUNTIME_MISSING=\"$RUNTIME_MISSING uv\"\nfi\n[ -z \"$RUNTIME_MISSING\" ] || die \"required runtime missing after install attempt:${RUNTIME_MISSING}\"\nsystemctl is-active --quiet docker || die \"docker service not active\"\nlog \"all required runtime present and verified\"\n\n# ---------------------------------------------------------------------------\n# DONE\n# ---------------------------------------------------------------------------\nSTATUS=\"OK\"\nwrite_status\nlog \"===== k3-p4 bootstrap OK (v4) =====\"\nexit 0\n"
