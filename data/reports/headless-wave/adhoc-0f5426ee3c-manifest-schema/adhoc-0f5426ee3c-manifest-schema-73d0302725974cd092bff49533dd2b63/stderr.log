:   fi\r\n  81:   mkdir -p \"$(dirname \"$dst\")\"\r\n  82:   tmp=\"$dst.tmp.$$\"\r\n  83:   cp -p \"$src\" \"$tmp\"\r\n  84:   mv -f \"$tmp\" \"$dst\"\r\n  85: done\r\n  86: \r\n  87: echo \"changed: $changed\"\r\n  88: if [[ $DRY_RUN -eq 1 ]]; then\r\n  89:   echo 'DRY RUN complete; no files or configuration were written.'\r\n  90:   exit 0\r\n  91: fi\r\n  92: [[ -d \"$backup\" ]] && echo \"backup: $backup\"\r\n  93: \r\n  94: if [[ $SKIP_USER_CONFIG -eq 0 ]]; then\r\n  95:   args=(--repo \"$TARGET\")\r\n  96:   [[ $SKIP_SMOKE -eq 1 ]] && args+=(--skip-smoke)\r\n  97:   \"$TARGET/install.sh\" \"${args[@]}\"\r\n  98: fi\r\n  99: \r\n 100: \"$PY\" - \"$TARGET\" <<'PY'\r\n 101: import sys\r\n 102: from pathlib import Path\r\n 103: root = Path(sys.argv[1]).resolve()\r\n 104: for sub in (\"harness\", \"metering\", \"hooks\"):\r\n 105:     sys.path.insert(0, str(root / sub))\r\n 106: from orchestration_common import LoopPaths, OrchestrationPolicy, RefillPolicy\r\n 107: paths = LoopPaths.resolve(root)\r\n 108: policy = OrchestrationPolicy.load(paths)\r\n 109: refill = RefillPolicy.load(paths)\r\n 110: assert policy.routing_mode() in {\"cold_start\", \"shadow\", \"layered\"}\r\n 111: assert (refill.target_total(), refill.v4_target(), refill.k3_target()) == (48, 36, 12)\r\n 112: import refill_consumer_v2, headless_wave, lifecycle_supervisor  # noqa: F401\r\n 113: print(\"v2 validation OK: mode=%s target=48/36/12\" % policy.routing_mode())\r\n 114: PY\r\n 115: \r\n 116: echo 'install_v2.sh: SUCCESS'\r\n","exit_code":0,"status":"completed"}}
