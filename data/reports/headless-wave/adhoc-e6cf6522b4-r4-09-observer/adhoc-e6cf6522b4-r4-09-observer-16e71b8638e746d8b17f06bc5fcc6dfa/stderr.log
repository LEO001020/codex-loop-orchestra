        return self._queue_mutate(lambda p: p.__setitem__(pool, int(count)))

    def queue_add(self, count: int, pool: str) -> dict[str, int]:
        return self._queue_mutate(
            lambda p: p.__setitem__(pool, p.get(pool, 0) + int(count)))

