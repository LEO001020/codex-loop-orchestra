"""从 APK 的 classes*.dex (MUTF-8) 与 resources.arsc (UTF-16LE) 中抽取字符串，
用于在荣耀侧边栏包里定位 Settings 开关键名。只读，不写设备。"""
import io
import re
import sys
import zipfile

ASCII_RE = re.compile(rb"[\x20-\x7e]{4,}")


def dex_strings(data: bytes):
    """MUTF-8 中的 ASCII 常量：抓连续可打印 ASCII 段。"""
    out = set()
    for m in ASCII_RE.finditer(data):
        s = m.group().decode("ascii")
        out.add(s)
    return out


def arsc_strings(data: bytes):
    """resources.arsc 的字符串池多为 UTF-16LE。"""
    out = set()
    # 按 2 字节对齐扫描连续可打印 ASCII（低字节 ASCII，高字节 0）
    pat = re.compile(rb"(?:[\x20-\x7e]\x00){4,}")
    for m in pat.finditer(data):
        out.add(m.group().decode("utf-16-le"))
    return out


def main(apk: str, keywords):
    kws = [k.lower() for k in keywords]
    z = zipfile.ZipFile(apk)
    hits = {"dex": set(), "arsc": set()}
    for name in z.namelist():
        raw = z.read(name)
        if name.endswith(".dex"):
            bucket = "dex"
            strings = dex_strings(raw)
        elif name == "resources.arsc":
            bucket = "arsc"
            strings = arsc_strings(raw)
        else:
            continue
        for s in strings:
            low = s.lower()
            if any(k in low for k in kws):
                hits[bucket].add(s)
        sys.stderr.write(f"  scanned {name} ({len(raw)} bytes) -> {len(strings)} strings\n")
    for bucket in ("dex", "arsc"):
        print(f"\n===== {bucket} hits ({len(hits[bucket])}) =====")
        for s in sorted(hits[bucket]):
            print("  ", s)


if __name__ == "__main__":
    apk = sys.argv[1]
    keywords = sys.argv[2:] or ["globalwindow", "dockbar"]
    main(apk, keywords)

