bagents(sessions_root)\r\n 631|    rollout_by_id = {str(row.get(\"agent_id\")): row\r\n 632|                     for row in (rollout.get(\"tasks\") or [])\r\n 633|                     if row.get(\"agent_id\")}\r\n 634|\r\n 635|    def observed_model(agent_id: Any, row: dict[str, Any]) -> Any:\r\n 636|        \"\"\"Prefer roster evidence, then the same child's real turn_context.\"\"\"\r\n 637|        return (row.get(\"model\")\r\n 638|                or (rollout_by_id.get(str(agent_id), {}) or {}).get(\"model\"))\r\n 639|\r\n 640|    def effective_model(model: Any, role: Any) -> str:\r\n 641|        \"\"\"Use configured role routing only when runtime evidence is not flushed yet.\"\"\"\r\n 642|        if model:\r\n 643|            return str(model)\r\n 644|        role_text = str(role or \"\").casefold()\r\n 645|        if any(word in role_text for word in (\"reviewer\", \"verifier\", \"plan_expander\")):\r\n 646|            return str(execution_profile.get(\"review_model\") or \"\")\r\n 647|        if any(word in role_text for word in (\"worker\", \"duty_officer\", \"executor\", \"scout\")):\r\n 648|            return str(execution_profile.get(\"model\") or \"\")\r\n 649|        return \"\"\r\n 650|\r\n 651|    def routing_metadata(agent_id: Any, role: Any, actual_model: Any) -> dict[str, Any]:\r\n 652|        evidence = rollout_by_id.get(str(agent_id), {}) or {}\r\n 653|        role_text = str(role or \"\").casefold()\r\n 654|        explicit_role = evidence.get(\"agent_role_explicit\")\r\n 655|        if explicit_role is None:\r\n 656|            explicit_role = bool(role_text and role_text != \"agent\")\r\n 657|        if any(word in role_text for word in (\"reviewer\", \"verifier\", \"plan_expander\")):\r\n 658|            expected = str(execution_profile.get(\"review_model\") or \"\")\r\n 659|        elif any(word in role_text for word in (\"worker\", \"duty_officer\", \"executor\", \"scout\")):\r\n 660|            expected = str(execution_profile.get(\"model\")