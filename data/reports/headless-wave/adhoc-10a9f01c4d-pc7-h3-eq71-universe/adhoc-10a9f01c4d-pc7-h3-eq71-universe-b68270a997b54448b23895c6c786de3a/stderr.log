ä¼šå¯åŠ?SSHã€‚\n\nå®ƒé‡‡ç”¨ä»¥ä¸‹å¤ç”¨è§„åˆ™ï¼š\n\n1. æ‰«æçŽ°æœ‰ `ssh.exe`ã€‚\n2. å¿…é¡»åŒæ—¶åŒ¹é… Windows ç³»ç»Ÿ SSH è·¯å¾„ã€ç§é’¥è·¯å¾„ã€`known_hosts` è·¯å¾„ã€å®Œæ•´è½¬å‘è§„æ ¼å’Œç›®æ ‡åœ°å€ã€‚\n3. å¦‚æžœæ‰¾åˆ°ä¸”ç«¯åˆ°ç«¯ HTTP æŽ¢æµ‹æˆåŠŸï¼Œç›´æŽ¥å¤ç”¨ã€‚\n4. å¦‚æžœç«¯å£è¢«å…¶ä»–ç¨‹åºå ç”¨ï¼Œæ‹’ç»å¯åŠ¨ï¼Œä¸ä¼šæ€æ­»å ç”¨è€…ã€‚\n5. å¦‚æžœå‘çŽ°ç›®æ ‡ SSH è¿›ç¨‹ä½†é“¾è·¯ä¸å¥åº·ï¼Œæ‹’ç»è‡ªåŠ¨è¦†ç›–ï¼Œè¦æ±‚å…ˆæ£€æŸ¥æˆ–æ˜¾å¼åœæ­¢ã€‚\n6. æ–°è¿›ç¨‹å¿…é¡»åœ¨å¯åŠ¨çª—å£å†…é€šè¿‡ HTTP ç«¯åˆ°ç«¯æŽ¢æµ‹ï¼Œå¦åˆ™å›žæ»šåˆšå¯åŠ¨çš„è¿›ç¨‹ã€‚\n\n```powershell\n$K3Tunnel = [pscustomobject]@{\n    SshExe      = \"$env:WINDIR\\System32\\OpenSSH\\ssh.exe\"\n    Key         = 'C:\\Users\\hzq00\\Downloads\\pi-agent\\VPS\\æœ€ç»ˆ\\k3_p4_fable_ed25519_PRIVATE_KEY.txt'\n    KnownHosts  = 'C:\\Users\\hzq00\\Documents\\Codex\\2026-08-09\\google-cloud-shell-gcloud-k3-p4\\work\\filebrowser-runtime\\known_hosts'\n    Destination = 'k3@136.85.49.91'\n    LocalAddress = '127.0.0.1'\n    LocalPort    = 8765\n    Forward      = '127.0.0.1:8765:127.0.0.1:8080'\n}\n\nfunction Test-K3TunnelProcessSignature {\n    param(\n        [Parameter(Mandatory)]\n        [object] $CimProcess\n    )\n\n    if (-not [string]::Equals(\n        [string]$CimProcess.ExecutablePath,\n        [string]$K3Tunnel.SshExe,\n        [StringComparison]::OrdinalIgnoreCase\n    )) {\n        return $false\n    }\n\n    $commandLine = [string]$CimProcess.CommandLine\n\n    if ([string]::IsNullOrWhiteSpace($commandLine)) {\n        return $false\n    }\n\n    $requiredText = @(\n        $K3Tunnel.Key\n        $K3Tunnel.KnownHosts\n        $K3Tunnel.Forward\n        $K3Tunnel.Destination\n    )\n\n    foreach ($text in $requiredText) {\n        if ($commandLine.IndexOf(\n            [string]$text,\n            [StringComparison]::OrdinalIgnoreCase\n        ) -lt 0) {\n            return $false\n        }\n    }\n\n    return $true\n}\n\nfunction Get-K3TunnelProcess {\n    $processes = @(\n        Get-CimInstance Win32_Process `\n            -Filter \"Name='ssh.exe'\" `\n            -ErrorAction SilentlyContinue\n    )\n\n    foreach ($process in $processes) {\n        if (Test-K3TunnelProcessSignature -CimProcess $process) {\n            $process\n        }\n    }\n}\n\nfunction Invoke-K3TunnelHttpProbe {\n    param(\n        [ValidateRange(100, 60000)]\n        [int] $TimeoutMilliseconds = 5000\n    )\n\n    $client = $null\n    $reader = $null\n    $asyncResult = $null\n\n    try {\n        $client = [Net.Sockets.TcpClient]::new()\n\n        $asyncResult = $client.BeginConnect(\n            $K3Tunnel.LocalAddress,\n            $K3Tunnel.LocalPort,\n            $null,\n            $null\n        )\n\n        if (-not $asyncResult.AsyncWaitHandle.WaitOne($TimeoutMilliseconds)) {\n            throw \"TCP connect timed out after $TimeoutMilliseconds ms\"\n        }\n\n        $client.EndConnect($asyncResult)\n\n        $stream = $client.GetStream()\n        $stream.ReadTimeout = $TimeoutMilliseconds\n        $stream.WriteTimeout = $TimeoutMilliseconds\n\n        $request = @(\n            'GET / HTTP/1.1'\n            \"Host: $($K3Tunnel.LocalAddress):$($K3Tunnel.LocalPort)\"\n            'Connection: close'\n            ''\n            ''\n        ) -join \"`r`n\"\n\n        $requestBytes = [Text.Encoding]::ASCII.GetBytes($request)\n        $stream.Write($requestBytes, 0, $requestBytes.Length)\n        $stream.Flush()\n\n        $reader = [IO.StreamReader]::new(\n            $stream,\n            [Text.Encoding]::ASCII,\n            $false,\n            1024,\n            $true\n        )\n\n        $statusLine = $reader.ReadLine()\n\n        $success = $statusLine -match '^HTTP/\\d+\\.\\d+\\s+\\d{3}\\b'\n\n        [pscustomobject]@{\n            Success    = [bool]$success\n            StatusLine = $statusLine\n            Error      = if ($success) { $null } else { 'No valid HTTP status line received' }\n        }\n    }\n    catch {\n        [pscustomobject]@{\n            Success    = $false\n            StatusLine = $null\n            Error      = $_.Exception.Message\n        }\n    }\n    finally {\n        if ($reader) {\n            $reader.Dispose()\n        }\n\n        if ($asyncResult -and $asyncResult.AsyncWaitHandle) {\n            $asyncResult.AsyncWaitHandle.Dispose()\n        }\n\n        if ($client) {\n            $client.Dispose()\n        }\n    }\n}\n\nfunction Test-K3Tunnel {\n    param(\n        [switch] $Quiet\n    )\n\n    $matchingProcesses = @(Get-K3TunnelProcess)\n\n    $allListeners = @(\n        Get-NetTCPConnection `\n            -State Listen `\n            -LocalPort $K3Tunnel.LocalPort `\n            -ErrorAction SilentlyContinue\n    )\n\n    $loopbackListeners = @(\n        $allListeners |\n            Where-Object {\n                $_.LocalAddress -eq $K3Tunnel.LocalAddress\n            }\n    )\n\n    $matchingProcessIds = @(\n        $matchingProcesses |\n            ForEach-Object { [uint32]$_.ProcessId }\n    )\n\n    $ownedListeners = @(\n        $loopbackListeners |\n            Where-Object {\n                $matchingProcessIds -contains [uint32]$_.OwningProcess\n            }\n    )\n\n    $probe = if ($ownedListeners.Count -eq 1) {\n        Invoke-K3TunnelHttpProbe\n    }\n    else {\n        [pscustomobject]@{\n            Success    = $false\n            StatusLine = $null\n            Error      = 'Expected loopback listener is absent or ambiguous'\n        }\n    }\n\n    $healthy = (\n        $matchingProcesses.Count -eq 1 -and\n        $ownedListeners.Count -eq 1 -and\n        $probe.Success\n    )\n\n    if ($Quiet) {\n        return [bool]$healthy\n    }\n\n    [pscustomobject]@{\n        Healthy              = [bool]$healthy\n        MatchingProcessCount = $matchingProcesses.Count\n        ProcessId            = if ($matchingProcesses.Count -eq 1) {\n            [uint32]$matchingProcesses[0].ProcessId\n        }\n        else {\n            $null\n        }\n        L