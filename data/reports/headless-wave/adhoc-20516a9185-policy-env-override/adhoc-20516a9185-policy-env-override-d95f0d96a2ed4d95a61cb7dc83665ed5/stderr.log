e\r\n 281:             if isinstance(rec, dict):\r\n 282:                 yield rec\r\n 283: \r\n 284: \r\n 285: # ---------------------------------------------------------------------------\r\n 286: # Semantic idempotency keys (V10 k3IdemKey pattern)\r\n 287: # ---------------------------------------------------------------------------\r\n 288: def idem_key(kind: str, scope: str, *semantic_fields: str) -> str:\r\n 289:     \"\"\"Build ``k3:<kind>:<scope>:<b32(sha256(fields))[:16]>``.\r\n 290: \r\n 291:     The key is derived from *semantic* fields (never timestamps), so the same\r\n 292:     logical request always maps to the same key тА?the exactly-once boundary\r\n 293:     for the l2 consumer and every append-only ledger record.\r\n 294:     \"\"\"\r\n 295:     digest = hashlib.sha256(\"|\".join(semantic_fields).encode(\"utf-8\")).digest()\r\n 296:     suffix = base64.b32encode(digest).decode(\"ascii\").lower().rstrip(\"=\")[:16]\r\n 297:     return f\"k3:{kind}:{scope}:{suffix}\"\r\n 298: \r\n 299: \r\n 300: # ---------------------------------------------------------------------------\r\n 301: # Policy loading тА?fail-closed\r\n 302: # ---------------------------------------------------------------------------\r\n 303: def _load_toml(path: Path, what: str) -> dict[str, Any]:\r\n 304:     if not path.exists():\r\n 305:         raise PolicyError(f\"{what} missing: {path} тА?refusing silent defaults \"\r\n 306:                           f\"(P0-8.3 fail-closed policy reads)\")\r\n 307:     try:\r\n 308:         with path.open(\"rb\") as handle:\r\n 309:             return tomllib.load(handle)\r\n 310:     except (OSError, tomllib.TOMLDecodeError) as exc:\r\n 311:         raise PolicyError(f\"{what} unreadable: {path}: {exc}\") from exc\r\n 312: \r\n 313: \r\n 314: @dataclass\r\n 315: class OrchestrationPolicy:\r\n 316:     \"\"\"Typed view over ``config/orchestration_policy.toml``.\r\n 317: \r\n 318:     Declaration face = enforcement face (design invariant 2): every limit the\r\n 319:     file declares is read here and enforced by the component that owns it.\r\n 320:     Concurrency numbers are **not** duplicated here тА?they live only in\r\n 321:     ``refill_policy.toml`` (invariant 3); this policy carries a\r\n 322:     ``refill_policy_ref`` key instead.\r\n 323:     \"\"\"\r\n 324: \r\n 325:     doc: dict[str, Any] = field(default_factory=dict)\r\n 326:     path: Path | None = None\r\n 327: \r\n 328:     @classmethod\r\n 329:     def load(cls, paths: LoopPaths | None = None) -> \"OrchestrationPolicy\":\r\n 330:         paths = paths or LoopPaths.resolve()\r\n 331:         explicit = os.environ.get(\"LOOP_ORCH_POLICY\")\r\n 332:         policy_path = (Path(explicit).resolve() if explicit\r\n 333:                        else paths.config / \"orchestration_policy.toml\")\r\n 334:         return cls(_load_toml(policy_path, \"orchestration policy\"), policy_path)\r\n 335: \r\n 336:     # -- generic accessors ----------------------------------------------------\r\n 337:     def value(self, section: str, key: str, default: Any = None) -> Any:\r\n 338:         table = self.doc.get(section, {})\r\n 339:         return table.get(key, default) if isinstance(table, dict) else default\r\n 340: \r\n 341:     def require(self, section: str, key: str) -> Any:\r\n 342:         value = self.value(section, key, None)\r\n 343:         if value is None:\r\n 344:             raise PolicyError(\r\n 345:                 f\"orchestration policy [{section}].{key} missing in {self.path} \"\r\n 346:                 f\"тА?fail-closed (declaration face = enforcement face)\")\r\n 347:         return value\r\n 348: \r\n 349:     # -- routing ---------------------------------------------------------------\r\n 350:     def routing_mode(self) -> str:\r\n 351:         \"\"\"``cold_start`` | ``shadow`` | ``layered``.\r\n 352: \r\n 353:         ``passthrough_enabled`` (legacy boolean) is honoured only as an alias:\r\n 354:         ``false -> cold_start``, ``