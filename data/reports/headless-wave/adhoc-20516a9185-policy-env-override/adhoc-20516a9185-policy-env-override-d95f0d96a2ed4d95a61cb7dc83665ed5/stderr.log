-----------------------------------\r\n 197: @contextlib.contextmanager\r\n 198: def file_lock(path: Path) -> Iterator[None]:\r\n 199:     \"\"\"Cross-process one-byte advisory lock (same protocol the shipped\r\n 200:     ``lifecycle_supervisor.locked`` uses, so v2 components interoperate with\r\n 201:     v1 writers on the same lock files).\"\"\"\r\n 202:     path = Path(path)\r\n 203:     path.parent.mkdir(parents=True, exist_ok=True)\r\n 204:     with path.open(\"a+b\") as handle:\r\n 205:         handle.seek(0, os.SEEK_END)\r\n 206:         if handle.tell() == 0:\r\n 207:             handle.write(b\"\\0\")\r\n 208:             handle.flush()\r\n 209:         handle.seek(0)\r\n 210:         if os.name == \"nt\":  # pragma: no cover - Windows plane\r\n 211:             import msvcrt\r\n 212: \r\n 213:             msvcrt.locking(handle.fileno(), msvcrt.LK_LOCK, 1)\r\n 214:         else:\r\n 215:             import fcntl\r\n 216: \r\n 217:             fcntl.flock(handle.fileno(), fcntl.LOCK_EX)\r\n 218:         try:\r\n 219:             yield\r\n 220:         finally:\r\n 221:             handle.seek(0)\r\n 222:             if os.name == \"nt\":  # pragma: no cover - Windows plane\r\n 223:                 import msvcrt\r\n 224: \r\n 225:                 msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)\r\n 226:             else:\r\n 227:                 import fcntl\r\n 228: \r\n 229:                 fcntl.flock(handle.fileno(), fcntl.LOCK_UN)\r\n 230: \r\n 231: \r\n 232: def read_json(path: Path | str, default: Any = None) -> Any:\r\n 233:     \"\"\"Read JSON, returning ``default`` on any IO/parse failure.\"\"\"\r\n 234:     try:\r\n 235:         return json.loads(Path(path).read_text(encoding=\"utf-8\"))\r\n 236:     except (OSError, ValueError):\r\n 237:         return default\r\n 238: \r\n 239: \r\n 240: def atomic_write_json(path: Path | str, value: Any) -> None:\r\n 241:     \"\"\"Write JSON atomically (tmp file + ``os.replace``); fsynced.\"\"\"\r\n 242:    