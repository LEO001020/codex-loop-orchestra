return float(self.value(\"routing\", \"l2_max_age_s\", 900))\r\n 421: \r\n 422: \r\n 423: @dataclass\r\n 424: class RefillPolicy:\r\n 425:     \"\"\"Typed, fail-closed view over ``config/refill_policy.toml`` тА?the ONLY\r\n 426:     concurrency authority (P0-8.3).  Any read failure raises\r\n 427:     :class:`PolicyError` instead of returning a divergent default.\"\"\"\r\n 428: \r\n 429:     doc: dict[str, Any] = field(default_factory=dict)\r\n 430:     path: Path | None = None\r\n 431: \r\n 432:     @classmethod\r\n 433:     def load(cls, paths: LoopPaths | None = None) -> \"RefillPolicy\":\r\n 434:         paths = paths or LoopPaths.resolve()\r\n 435:         explicit = os.environ.get(\"LOOP_REFILL_POLICY\")\r\n 436:         policy_path = (Path(explicit).resolve() if explicit\r\n 437:                        else paths.config / \"refill_policy.toml\")\r\n 438:         return cls(_load_toml(policy_path, \"refill policy\"), policy_path)\r\n 439: \r\n 440:     def _int(self, section: str, key: str) -> int:\r\n 441:         table = self.doc.get(section, {})\r\n 442:         value = table.get(key) if isinstance(table, dict) else None\r\n 443:         if not isinstance(value, int) or isinstance(value, bool):\r\n 444:             raise PolicyError(f\"refill policy [{section}].{key} missing/invalid \"\r\n 445:                               f\"in {self.path} тА?fail-closed, no silent default\")\r\n 446:         return value\r\n 447: \r\n 448:     def target_total(self) -> int:\r\n 449:         return self._int(\"concurrency\", \"target_total\")           # 48\r\n 450: \r\n 451:     def v4_target(self) -> int:\r\n 452:         return self._int(\"concurrency\", \"v4_target\")              # 36\r\n 453: \r\n 454:     def k3_target(self) -> int:\r\n 455:         return self._int(\"concurrency\", \"k3_target\")              # 12\r\n 456: \r\n 457:     def v4_low_water(self) -> int:\r\n 458:         return self._int(\"concurrency\", \"v4_low_water\")\r\n 459: \r\n 460:     def k3