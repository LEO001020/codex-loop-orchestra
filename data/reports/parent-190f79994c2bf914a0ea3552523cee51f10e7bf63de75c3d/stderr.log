t, []):\r\n 257:         commands = \" \".join(str(h.get(\"command\", \"\")) + \" \" +\r\n 258:                             str(h.get(\"commandWindows\", \"\"))\r\n 259:                             for h in entry.get(\"hooks\", []))\r\n 260:         if not any(name in commands for name in managed):\r\n 261:             kept.append(entry)\r\n 262:     hooks[event] = kept + entries\r\n 263: rendered = json.dumps(current, ensure_ascii=False, indent=2) + \"\\n\"\r\n 264: if os.path.exists(target_path) and open(target_path, encoding=\"utf-8\").read() == rendered:\r\n 265:     print(\"SKIP  hooks.json already contains canonical LOOP hooks\")\r\n 266:     raise SystemExit(0)\r\n 267: if os.path.exists(target_path):\r\n 268:     backup = target_path + \".bak.\" + time.strftime(\"%Y%m%dT%H%M%SZ\", time.gmtime()) + \".\" + str(time.time_ns())\r\n 269:     shutil.copy2(target_path, backup)\r\n 270:     print(\"BACKUP hooks.json -> %s\" % backup)\r\n 271: fd, tmp = tempfile.mkstemp(prefix=\"hooks.json.\", dir=os.path.dirname(target_path))\r\n 272: with os.fdopen(fd, \"w\", encoding=\"utf-8\") as handle:\r\n 273:     handle.write(rendered)\r\n 274: os.replace(tmp, target_path)\r\n 275: print(\"MERGED canonical router + lifecycle hooks -> %s\" % target_path)\r\n 276: PYEOF\r\n 277: say \"NOTE  Hooks require trust: run /hooks in the Codex TUI once, or pass\"\r\n 278: say \"      --dangerously-bypass-hook-trust for non-interactive codex exec runs.\"\r\n 279: \r\n 280: # ----------------------------------------------------------------------------\r\n 281: # иббо?Smoke gate (mandatory after install and after every Codex upgrade)\r\n 282: # ----------------------------------------------------------------------------\r\n 283: step \"5/5 Smoke gate\"\r\n 284: if [[ \"$SKIP_SMOKE\" -eq 1 ]]; then\r\n 285:   say \"SKIPPED (--skip-smoke). Run it before first use: $PKG_ROOT/harness/smoke_gate.sh\"\r\n 286:   exit 0\r\n 287: fi\r\n 288: if \"$PKG_ROOT/harness/smoke_gate.sh\" \"$PKG_ROOT\"; t