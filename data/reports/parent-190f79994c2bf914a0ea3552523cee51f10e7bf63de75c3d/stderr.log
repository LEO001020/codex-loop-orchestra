pile(r\"^\\s*([A-Za-z0-9_\\-]+)\\s*=\")\r\n 143: missing = {}   # section -> [raw key lines]\r\n 144: section = \"\"\r\n 145: in_multiline = False\r\n 146: with open(example_path) as f:\r\n 147:     for raw in f:\r\n 148:         line = raw.rstrip(\"\\n\")\r\n 149:         if in_multiline:\r\n 150:             missing.setdefault(section, [])\r\n 151:             if section in missing and missing[section] and missing[section][-1][0]:\r\n 152:                 missing[section][-1][1].append(line)\r\n 153:             if '\"\"\"' in line:\r\n 154:                 in_multiline = False\r\n 155:             continue\r\n 156:         m = sec_re.match(line)\r\n 157:         if m:\r\n 158:             section = m.group(1)\r\n 159:             continue\r\n 160:         m = key_re.match(line)\r\n 161:         if m and not line.lstrip().startswith(\"#\"):\r\n 162:             key = m.group(1)\r\n 163:             if not has_key(user, section, key):\r\n 164:                 missing.setdefault(section, []).append([key, [line]])\r\n 165:             if line.count('\"\"\"') == 1:\r\n 166:                 in_multiline = True\r\n 167: \r\n 168: with open(user_path) as f:\r\n 169:     user_lines = f.read().splitlines()\r\n 170: \r\n 171: new_lines = list(user_lines)\r\n 172: appended = []\r\n 173: for section, entries in missing.items():\r\n 174:     if not entries:\r\n 175:         continue\r\n 176:     header = f\"[{section}]\"\r\n 177:     lines = [l for _, block in entries for l in block]\r\n 178:     idx = next((i for i, l in enumerate(new_lines) if l.strip() == header), None)\r\n 179:     if idx is not None:\r\n 180:         new_lines[idx+1:idx+1] = lines           # insert just after existing header\r\n 181:     else:\r\n 182:         appended += [\"\", f\"# merged from codex-loop-s-f2 config.toml.example\", header] + lines\r\n 183: \r\n 184: if appended:\r\n 185:     new_lines += appended\r\n 186: \r\n 187: if new_lines == user_lines:\r\n 188:     print(\"SKIP  config.toml alre