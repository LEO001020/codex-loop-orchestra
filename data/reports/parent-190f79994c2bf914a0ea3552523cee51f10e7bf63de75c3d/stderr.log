lure.\r\n  20: # Idempotency: re-running produces no duplicate keys, no duplicate hook\r\n  21: #           entries, no destructive overwrites; every step detects prior state.\r\n  22: # ============================================================================\r\n  23: set -euo pipefail\r\n  24: \r\n  25: PKG_ROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\r\n  26: CODEX_HOME=\"${CODEX_HOME:-$HOME/.codex}\"\r\n  27: CODEX_BIN=\"${CODEX_BIN:-codex}\"\r\n  28: TARGET_REPO=\"$PWD\"\r\n  29: SKIP_SMOKE=0\r\n  30: \r\n  31: while [[ $# -gt 0 ]]; do\r\n  32:   case \"$1\" in\r\n  33:     --repo) TARGET_REPO=\"$(cd \"$2\" && pwd)\"; shift 2 ;;\r\n  34:     --skip-smoke) SKIP_SMOKE=1; shift ;;\r\n  35:     -h|--help)\r\n  36:       sed -n '2,24p' \"${BASH_SOURCE[0]}\"; exit 0 ;;\r\n  37:     *) echo \"Unknown argument: $1 (see --help)\" >&2; exit 1 ;;\r\n  38:   esac\r\n  39: done\r\n  40: \r\n  41: say()  { printf '%s\\n' \"$*\"; }\r\n  42: step() { printf '\\n== %s ==\\n' \"$*\"; }\r\n  43: \r\n  44: # ----------------------------------------------------------------------------\r\n  45: # Äâ€?Prerequisites: Node 22+ and Codex CLI. Missing -> prompt, never install.\r\n  46: # ----------------------------------------------------------------------------\r\n  47: step \"1/5 Prerequisite check (Node 22+, Codex CLI)\"\r\n  48: MISSING=0\r\n  49: \r\n  50: if command -v node >/dev/null 2>&1; then\r\n  51:   NODE_V=\"$(node --version)\"\r\n  52:   NODE_MAJOR=\"${NODE_V#v}\"; NODE_MAJOR=\"${NODE_MAJOR%%.*}\"\r\n  53:   if [[ \"$NODE_MAJOR\" -ge 22 ]]; then\r\n  54:     say \"OK    node $NODE_V (>= 22)\"\r\n  55:   else\r\n  56:     say \"WARN  node $NODE_V is < 22. Node 22 LTS is the pinned toolchain (VERSIONS.lock).\"\r\n  57:     say \"      Install (choose one, run yourself Äâ‚?this script will not):\"\r\n  58:     say \"        nvm install 22 && nvm use 22\"\r\n  59:     say \"        # or download https://nodejs.org/dist/v22.23.2/node-v22.23.2-linux-x64.tar.xz\"\r\n  60:     MISSING=1\r\n  61:   fi\r\n  62: else\r\n  63:   say \"MISSING node. Install Node 22 LTS yourself (this script will not):\"\r\n  64:   say \"        nvm install 22   # or see https://nodejs.org/en/download\"\r\n  65:   MISSING=1\r\n  66: fi\r\n  67: \r\n  68: if command -v \"$CODEX_BIN\" >/dev/null 2>&1; then\r\n  69:   CODEX_V=\"$(\"$CODEX_BIN\" --version 2>/dev/null | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' | head -1 || echo unknown)\"\r\n  70:   LOCK_V=\"$(grep -E '^codex_cli_version' \"$PKG_ROOT/VERSIONS.lock\" 2>/dev/null | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' | head -1 || echo unpinned)\"\r\n  71:   say \"OK    codex $CODEX_V (VERSIONS.lock pins $LOCK_V)\"\r\n  72:   if [[ \"$CODEX_V\" != \"$LOCK_V\" ]]; then\r\n  73:     say \"WARN  version drift vs VERSIONS.lock Äâ‚?smoke gate MUST be re-run after every Codex upgrade (Ä€Â§7.4).\"\r\n  74:   fi\r\n  75: else\r\n  76:   say \"MISSING codex CLI. Install yourself (choose one, this script will not):\"\r\n  77:   say \"        npm install -g @openai/codex\"\r\n  78:   say \"        curl -fsSL https://chatgpt.com/codex/install.sh | sh\"\r\n  79:   MISSING=1\r\n  80: fi\r\n  81: \r\n  82: if [[ \"$MISSING\" -eq 1 ]]; then\r\n  83:   say \"\"\r\n  84:   say \"ABORT: prerequisites missing (printed above). Re-run install.sh after installing them.\"\r\n  85:   exit 1\r\n  86: fi\r\n  87: \r\n  88: # ----------------------------------------------------------------------------\r\n  89: # Äâ€?Agent TOMLs -> $CODEX_HOME/agents/\r\n  90: # ----------------------------------------------------------------------------\r\n  91: step \"2/5 Agent TOMLs -> $CODEX_HOME/agents/\"\r\n  92: mkdir -p \"$CODEX_HOME/agents\"\r\n  93: for SRC in \"$PKG_ROOT\"/agents/*.toml; do\r\n  94:   BASE=\"$(basename \"$SRC\")\"\r\n  95:   DST=\"$CODEX_HOME/agents/$BASE\"\r\n  96:   if [[ -f \"$DST\" ]] && cmp -s \"$SRC\" \"$DST\"; then\r\n  97:     say \"SKIP  $BASE (identical already installed)\"\r\n  98:   elif [[ -f \"$DST\" ]]; then\