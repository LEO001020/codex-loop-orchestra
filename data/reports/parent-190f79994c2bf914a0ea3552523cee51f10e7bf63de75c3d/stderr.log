\r\n  60:     MISSING=1\r\n  61:   fi\r\n  62: else\r\n  63:   say \"MISSING node. Install Node 22 LTS yourself (this script will not):\"\r\n  64:   say \"        nvm install 22   # or see https://nodejs.org/en/download\"\r\n  65:   MISSING=1\r\n  66: fi\r\n  67: \r\n  68: if command -v \"$CODEX_BIN\" >/dev/null 2>&1; then\r\n  69:   CODEX_V=\"$(\"$CODEX_BIN\" --version 2>/dev/null | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' | head -1 || echo unknown)\"\r\n  70:   LOCK_V=\"$(grep -E '^codex_cli_version' \"$PKG_ROOT/VERSIONS.lock\" 2>/dev/null | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' | head -1 || echo unpinned)\"\r\n  71:   say \"OK    codex $CODEX_V (VERSIONS.lock pins $LOCK_V)\"\r\n  72:   if [[ \"$CODEX_V\" != \"$LOCK_V\" ]]; then\r\n  73:     say \"WARN  version drift vs VERSIONS.lock ибА?smoke gate MUST be re-run after every Codex upgrade (иббь7.4).\"\r\n  74:   fi\r\n  75: else\r\n  76:   say \"MISSING codex CLI. Install yourself (choose one, this script will not):\"\r\n  77:   say \"        npm install -g @openai/codex\"\r\n  78:   say \"        curl -fsSL https://chatgpt.com/codex/install.sh | sh\"\r\n  79:   MISSING=1\r\n  80: fi\r\n  81: \r\n  82: if [[ \"$MISSING\" -eq 1 ]]; then\r\n  83:   say \"\"\r\n  84:   say \"ABORT: prerequisites missing (printed above). Re-run install.sh after installing them.\"\r\n  85:   exit 1\r\n  86: fi\r\n  87: \r\n  88: # ----------------------------------------------------------------------------\r\n  89: # иббо?Agent TOMLs -> $CODEX_HOME/agents/\r\n  90: # ----------------------------------------------------------------------------\r\n  91: step \"2/5 Agent TOMLs -> $CODEX_HOME/agents/\"\r\n  92: mkdir -p \"$CODEX_HOME/agents\"\r\n  93: for SRC in \"$PKG_ROOT\"/agents/*.toml; do\r\n  94:   BASE=\"$(basename \"$SRC\")\"\r\n  95:   DST=\"$CODEX_HOME/agents/$BASE\"\r\n  96:   if [[ -f \"$DST\" ]] && cmp -s \"$SRC\" \"$DST\"; then\r\n  97:     say \"SKIP  $BASE (identical already installed)\"\r\n  98:   elif [[ -f \"$DST\" ]]; then\r\n  99:     BAK=\"$DST.bak.$(date -u +%Y%m%dT%H%M%SZ)-$$\"\r\n 100:     cp \"$DST\" \"$BAK\"\r\n 101:     cp \"$SRC\" \"$DST\"\r\n 102:     say \"REPLACED $BASE (previous version backed up: $BAK)\"\r\n 103:   else\r\n 104:     cp \"$SRC\" \"$DST\"\r\n 105:     say \"INSTALLED $BASE\"\r\n 106:   fi\r\n 107: done\r\n 108: \r\n 109: # ----------------------------------------------------------------------------\r\n 110: # иббо?Merge config.toml.example keys into $CODEX_HOME/config.toml\r\n 111: #    (existing keys never overwritten; diff printed for user confirmation)\r\n 112: # ----------------------------------------------------------------------------\r\n 113: step \"3/5 Config merge -> $CODEX_HOME/config.toml\"\r\n 114: USER_CFG=\"$CODEX_HOME/config.toml\"\r\n 115: EXAMPLE=\"$PKG_ROOT/config/config.toml.example\"\r\n 116: if [[ ! -f \"$USER_CFG\" ]]; then\r\n 117:   cp \"$EXAMPLE\" \"$USER_CFG\"\r\n 118:   say \"CREATED $USER_CFG from config.toml.example (no prior user config)\"\r\n 119: else\r\n 120:   python3 - \"$EXAMPLE\" \"$USER_CFG\" <<'PYEOF'\r\n 121: import re, sys, difflib, tempfile, os, shutil, time\r\n 122: try:\r\n 123:     import tomllib\r\n 124: except ImportError:  # pragma: no cover\r\n 125:     sys.exit(\"python3 with tomllib (3.11+) required for config merge\")\r\n 126: \r\n 127: example_path, user_path = sys.argv[1], sys.argv[2]\r\n 128: with open(user_path, \"rb\") as f:\r\n 129:     user = tomllib.load(f)\r\n 130: \r\n 131: def has_key(cfg, section, key):\r\n 132:     node = cfg\r\n 133:     if section:\r\n 134:         for part in section.split(\".\"):\r\n 135:             if not isinstance(node, dict) or part not in node:\r\n 136:                 return False\r\n 137:             node = node[part]\r\n 138:     return isinstance(node, dict) and key in node\r\n 139: \r\n 140: # Walk the example line-by-line; collect uncommented keys the user lacks.\r\n 141: sec_re = re.compile(r\"^\\s*\\[+([A-Za-z0-9_.\\-]+)\\]+\\s*$\")\r\n 142: key_re = re.compile(r\"^\\s*([A-Za-z0-9_\\-]+)\\s*=\")\r\n 143: missing = {}   # section -> [raw key lines]\r\n 144: section = \"\"\r\n 145: in_multiline = False\r\n 146: with open(example_path) as f:\r\n 147:     for raw in f:\r\n 148:         line = raw.rstrip(\"\\n\")\r\n 149:         if in_multiline:\r\n 150:             missing.setdefault(section, [])\r\n 151:             if section in missing and missing[section] and missing[section][-1][0]:\r\n 152:                 missing[section][-1][1].append(line)\r\n 153:             if '\"\"\"' in line:\r\n 154:                 in_multiline = False\r\n 155:             continue\r\n 156:         m = sec_re.match(line)\r\n 157:         if m:\r\n 158:             section = m.group(1)\r\n 159:             continue\r\n 160:         m = key_re.match(line)\r\n 161:         if m and not line.lstrip().startswith(\"#\"):\r\n 162:             key = m.group(1)\r\n 163:             if not has_key(user, section, key):\r\n 164:                 missing.setdefault(section, []).append([key, [line]])\r\n 165:             if line.count('\"\"\"') == 1:\r\n 166:                 in_multiline = True\r\n 167: \r\n 168: with open(user_path) as f:\r\n 169:     user_lines = f.read().splitlines()\r\n 170: \r\n 171: new_lines = list(user_lines)\r\n 172: appended = []\r\n 173: for section, entries in missing.items():\r\n 174:     if not entries:\r\n 175:         continue\r\n 176:     header = f\"[{section}]\"\r\n 177:     lines = [l for _, block in entries for l in block]\r\n 178:     idx = next((i for i, l in enumerate(new_lines) if l.strip() == header), None)\r\n 179:     if idx is not None:\r\n 180:         new_lines[idx+1:idx+1] = lines           # insert just after existing header\r\n 181:     else:\r\n 182:         appended += [\"\", f\"# merged from codex-loop-s-f2 config.toml.example\", header] + lines\r\n 183: \r\n 184: if appended:\r\n 185:     new_lines += appended\r\n 186: \r\n 187: if new_lines == user_lines:\r\n 188:     print(\"SKIP  config.toml already contains every key from config.toml.example\")\r\n 189:     sys.exit(0)\r\n 190: \r\n 191: diff = difflib.unified_diff(user_lines, new_lines,\r\n 192:                             fromfile=\"config.toml (before)\",\r\n 193:                             tofile=\"config.toml (after merge)\", lineterm=\"\")\r\n 194: print(\"Merged the following NEW keys (existing keys untouched) ибА?diff:\")\r\n 195: for d in diff:\r\n 196:     print(d)\r\n 197: rendered = \"\\n\".join(new_lines) + \"\\n\"\r\n 198: # Validate the exact bytes before preserving/replacing the user's config.\r\n 199: tomllib.loads(rendered)\r\n 200: backup = user_path + \".bak.\" + time.strftime(\"%Y%m%dT%H%M%SZ\", time.gmtime()) + \".\" + str(time.time_ns())\r\n 201: shutil.copy2(user_path, backup)\r\n 202: print(\"BACKUP config.toml -> %s\" % backup)\r\n 203: tmp = tempfile.NamedTemporaryFile(\"w\", delete=False, dir=os.path.dirname(user_path))\r\n 204: tmp.write(rendered)\r\n 205: tmp.close()\r\n 206: os.replace(tmp.name, user_path)\r\n 207: PYEOF\r\n 208: fi\r\n 209: \r\n 210: # ----------------------------------------------------------------------------\r\n 211: # иббо?data/ skeleton + hook mounting in the target git repo\r\n 212: # ----------------------------------------------------------------------------\r\n 213: step \"4/5 data/ skeleton + hook mount in target repo: $TARGET_REPO\"\r\n 214: if ! git -C \"$TARGET_REPO\" rev-parse --is-inside-work-tree >/dev/null 2>&1; then\r\n 215:   say \"WARN  $TARGET_REPO is not a git repo ибА?worktree pool / serial merge need git. Skeleton created anyway.\"\r\n 216: fi\r\n 217: DATA=\"$TARGET_REPO/data\"\r\n 218: mkdir -p \"$DATA/packets\" \"$DATA/reports\" \"$DATA/dead_letters\"\r\n 219: touch \"$DATA/events.ndjson\" \"$DATA/escalation_log.jsonl\" \"$DATA/lessons.jsonl\" \"$DATA/.merge.lock\"\r\n 220: [[ -f \"$DATA/progress_ledger.json\" ]] || printf '{\"packets\": {}, \"waves\": []}\\n' > \"$DATA/progress_ledger.json\"\r\n 221: say \"OK    data/ skeleton at $D